<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HF_HOME</key>
		<string>@LAYA_HOME@/cache</string>
		<key>HF_HUB_OFFLINE</key>
		<string>1</string>
		<key>TOKENIZERS_PARALLELISM</key>
		<string>false</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.jev-mobile.laya</string>
	<key>ProgramArguments</key>
	<array>
		<string>@LAYA_HOME@/.venv/bin/jev-mobile</string>
		<string>laya-serve</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>@LAYA_HOME@/server.stderr.log</string>
	<key>StandardOutPath</key>
	<string>@LAYA_HOME@/server.stdout.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>@LAYA_HOME@</string>
</dict>
</plist>
