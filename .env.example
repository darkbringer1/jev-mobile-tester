TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Use the local Laya server instead of TypeSafe (no API key required):
# JEV_BACKEND=laya
# LAYA_URL=http://127.0.0.1:8081
# Field input: use --values or MCP values with an ID-to-text mapping.
# Optional server defaults:
# JEV_DEVICE_ID=YOUR_SIMULATOR_UDID
# JEV_APP_ID=com.example.myapp
